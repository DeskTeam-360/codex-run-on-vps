[Unit]
Description=Codex ChatGPT Pro OpenAI-compatible API Proxy
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
Environment=HOME=/home/ubuntu
Environment=HOST=0.0.0.0
Environment=PORT=8787
Environment=CODEX_AUTH_FILE=/home/ubuntu/.codex/auth.json
ExecStart=/bin/bash /home/ubuntu/codex-run-on-vps/scripts/start-service.sh
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
